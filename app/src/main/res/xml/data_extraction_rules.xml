<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: same exclusion for cloud backup. Direct phone-to-phone transfer keeps everything. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
    </cloud-backup>
    <device-transfer>
    </device-transfer>
</data-extraction-rules>
